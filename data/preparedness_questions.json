      {
       "value": "key_service",
       "label": "鍵預かりサービスを利用"
      },
      {
       "value": "none",
       "label": "ない"
      }
     ]
    },
    {
     "id": "q_info_location",
     "text": "保険証・お薬手帳・介護保険証の場所を、家族の複数人が知っていますか?",
     "type": "yn_unknown"
    },
    {
     "id": "q_contact_shared",
     "text": "ケアマネさん・かかりつけ医の連絡先を家族間で共有していますか?",
     "type": "yn_unknown"
    }
