    {
     "id": "q_care_taxi",
     "text": "介護タクシーに事前登録していますか?",
     "type": "yn_unknown"
    },
    {
     "id": "q_short_stay",
     "text": "ショートステイの利用経験、または候補の当てはありますか?",
     "type": "yn_unknown"
    }
   ]
  },
  {
