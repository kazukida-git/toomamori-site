      },
      {
       "value": "w_self_down",
       "label": "自分が倒れたら、親はどうなるのか"
      },
      {
       "value": "w_money",
       "label": "介護にお金がどのくらいかかるのか分からない"
      },
      {
       "value": "w_work",
       "label": "仕事と両立できるか不安(休みや早退が増えている)"
