     "optional": true,
     "hint": "鏡や案内文を自然にするための任意項目です。答えなくても診断できます。",
     "options": [
      {
       "value": "mother",
       "label": "母"
      },
      {
       "value": "father",
       "label": "父"
      },
      {
       "value": "both",
       "label": "両親"
      },
      {
       "value": "other",
       "label": "その他"
